<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="pixel_editor.Views.CanvasResizeDialog"
        Width="380"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Title="Resize Canvas">

    <Grid Margin="24"
          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
          ColumnDefinitions="Auto,*"
          ColumnSpacing="12"
          RowSpacing="12">
        <TextBlock Grid.ColumnSpan="2"
                   Margin="0,0,0,4"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Text="Resize canvas" />

        <TextBlock Grid.Row="1"
                   VerticalAlignment="Center"
                   Text="Width:" />
        <NumericUpDown Grid.Row="1"
                       Grid.Column="1"
                       x:Name="WidthInput"
                       Minimum="1"
                       Maximum="4096"
                       Value="16"
                       Increment="1"
                       FormatString="0"
                       ParsingNumberStyle="Integer"
                       ClipValueToMinMax="True" />

        <TextBlock Grid.Row="2"
                   VerticalAlignment="Center"
                   Text="Height:" />
        <NumericUpDown Grid.Row="2"
                       Grid.Column="1"
                       x:Name="HeightInput"
                       Minimum="1"
                       Maximum="4096"
                       Value="16"
                       Increment="1"
                       FormatString="0"
                       ParsingNumberStyle="Integer"
                       ClipValueToMinMax="True" />

        <TextBlock Grid.Row="3"
                   Grid.Column="1"
                   x:Name="RangeText"
                   Foreground="#AFAFAF"
                   Text="1–4096 pixels" />

        <TextBlock Grid.Row="4"
                   VerticalAlignment="Center"
                   Text="Anchor:" />
        <ComboBox Grid.Row="4"
                  Grid.Column="1"
                  x:Name="AnchorInput"
                  SelectedIndex="4">
            <ComboBoxItem Content="Top left" />
            <ComboBoxItem Content="Top" />
            <ComboBoxItem Content="Top right" />
            <ComboBoxItem Content="Left" />
            <ComboBoxItem Content="Centre" />
            <ComboBoxItem Content="Right" />
            <ComboBoxItem Content="Bottom left" />
            <ComboBoxItem Content="Bottom" />
            <ComboBoxItem Content="Bottom right" />
        </ComboBox>

        <TextBlock Grid.Row="5"
                   Grid.ColumnSpan="2"
                   Foreground="#AFAFAF"
                   Text="Pixels outside the new canvas bounds will be cropped."
                   TextWrapping="Wrap" />

        <StackPanel Grid.Row="6"
                    Grid.ColumnSpan="2"
                    Margin="0,12,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="8">
            <Button Content="Cancel"
                    IsCancel="True"
                    Click="Cancel_OnClick" />
            <Button Content="Resize"
                    IsDefault="True"
                    Click="Resize_OnClick" />
        </StackPanel>
    </Grid>
</Window>
