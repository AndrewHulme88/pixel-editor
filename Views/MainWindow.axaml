<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:pixel_editor.Controls"
        xmlns:vm="using:pixel_editor.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="pixel_editor.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1000"
        Height="700"
        MinWidth="640"
        MinHeight="480"
        Icon="/Assets/avalonia-logo.ico"
        Title="Pixel Editor">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto"
          Background="#242424">
        <Border Padding="12,8"
                Background="#1B1B1B">
            <StackPanel Orientation="Horizontal"
                        Spacing="8">
                <RadioButton Content="Brush (B)"
                             GroupName="EditorTools"
                             HotKey="B"
                             IsChecked="{Binding IsBrushSelected, Mode=OneWay}"
                             Command="{Binding SelectBrushCommand}" />
                <RadioButton Content="Eraser (E)"
                             GroupName="EditorTools"
                             HotKey="E"
                             IsChecked="{Binding IsEraserSelected, Mode=OneWay}"
                             Command="{Binding SelectEraserCommand}" />
            </StackPanel>
        </Border>

        <controls:PixelCanvas Grid.Row="1"
                              x:Name="EditorCanvas"
                              Document="{Binding Document}"
                              BrushColor="{Binding BrushColor}"
                              ActiveTool="{Binding ActiveTool}"
                              Margin="24" />

        <Border Grid.Row="2"
                Padding="12,6"
                Background="#1B1B1B">
            <StackPanel Orientation="Horizontal"
                        Spacing="6">
                <TextBlock Foreground="#E6E6E6"
                           Text="{Binding ActiveTool}" />
                <TextBlock Margin="0,0,18,0"
                           Foreground="#E6E6E6"
                           Text="· Left-drag to draw" />
                <TextBlock Foreground="#AFAFAF"
                           Text="Pixel:" />
                <TextBlock MinWidth="60"
                           Foreground="#E6E6E6"
                           Text="{Binding HoveredPixelText, ElementName=EditorCanvas}" />
            </StackPanel>
        </Border>
    </Grid>

</Window>
